  <item>
    <title><![CDATA[PVC Cable Scrap]]></title>
    <link>https://alqaryangroup.com/materials-we-deal/pvc-cable-scrap/</link>
    <pubDate>Sun, 01 Nov 2026 12:00:00 +0000</pubDate>
