# Server Configuration
PORT=3000

# ---------------------------------------------------------------------------
# SECRETS LIVE HERE - NOT IN THE DATABASE
#
# The Firestore project is shared with the public web pages, so any key stored
# in the appData/settings document is readable by anyone who knows the project
# id. Set every credential below in the hosting environment instead
# (Render > your service > Environment). The server prefers these values and
# never writes them back to the database.
# ---------------------------------------------------------------------------

# Google Gemini API  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API  (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Alibaba DashScope / Qwen  (https://dashscope-intl.console.aliyun.com)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# Protects the endpoints that read or change secrets (/api/env, /api/knowledge).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=your_long_random_admin_token_here

# Meta WhatsApp Cloud API Configuration
# Get these from Meta for Developers Portal
WHATSAPP_TOKEN=your_meta_whatsapp_access_token_here
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
VERIFY_TOKEN=your_custom_verification_token_here
API_VERSION=v20.0

# Other
OWNER_PHONE_NUMBER=+9715xxxxxxxx
STAGING_MODE=0
